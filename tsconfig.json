{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "rootDir": "./src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "$commands/*": ["./src/commands/*"],
      "$lib/*": ["./src/lib/*"],
      "$models/*": ["./src/models/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
